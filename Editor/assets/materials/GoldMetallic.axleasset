Material {
    name: "GoldMetallic"
    shader: "ForwardPBR"

    // Base Color & Texture
    albedoColor: "#FFD600"
    albedoMap: ""

    // Surface Microfacet
    metallic: 1.0
    roughness: 0.15
    normalMap: ""
    normalStrength: 1.0

    // Emission & UV Scaling
    emissionColor: "#000000"
    emissionIntensity: 0.0
    uvScale: [1.0, 1.0]
}
