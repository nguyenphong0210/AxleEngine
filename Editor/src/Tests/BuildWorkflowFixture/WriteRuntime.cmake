# Process/packaging fixtures only. These files are never executed as a game.
if(EXISTS "${FLAGS}/FailBuild.flag")
    message(FATAL_ERROR "Intentional Runtime build failure")
endif()
if(EXISTS "${FLAGS}/SlowBuild.flag")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 20)
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(WRITE "${OUTPUT}/AxleRuntime.exe" "fresh runtime fixture")
file(WRITE "${OUTPUT}/AxleScripts.dll" "matching scripts fixture")
