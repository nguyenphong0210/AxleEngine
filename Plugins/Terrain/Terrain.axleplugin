{
  "schema": 1,
  "id": "axle.terrain",
  "name": "Axle Terrain & Sculpting System",
  "version": "1.0.0",
  "category": "Environment",
  "author": "AxleEngine Team",
  "description": "Owned heightfield data, SDK Inspector and lifecycle line preview. Advanced terrain prototypes remain separate.",
  "engineApiVersion": 1,
  "platforms": ["windows-x64"],
  "dependencies": [{"id": "axle.spline", "version": "1.0.0"}],
  "modules": [
    {
      "name": "TerrainRuntime",
      "kind": "runtime",
      "sourceRoot": "Runtime",
      "dependencies": [
        "SplineRuntime"
      ]
    },
    {
      "name": "TerrainEditor",
      "kind": "editor",
      "sourceRoot": "Editor",
      "dependencies": [
        "TerrainRuntime",
        "SplineEditor"
      ]
    }
  ]
}
