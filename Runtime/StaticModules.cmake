# Included only by a shipping build, after the generic host targets exist.
function(axle_add_plugin_module target kind)
    if(NOT target IN_LIST AXLE_SELECTED_PLUGIN_MODULES)
        return()
    endif()
    if(NOT kind STREQUAL "runtime" OR NOT AXLE_PLUGIN_${target}_KIND STREQUAL "runtime")
        message(FATAL_ERROR "Shipping modules must be Runtime modules: ${target}")
    endif()
    add_library(${target} STATIC ${ARGN})
    set_property(TARGET ${target} PROPERTY AXLE_SDK_MODULE TRUE)
    target_compile_features(${target} PRIVATE cxx_std_20)
    string(HEX "${target}" entryIdentity)
    target_compile_definitions(${target} PRIVATE
        AXLE_PLUGIN_ID="${AXLE_PLUGIN_${target}_ID}"
        AXLE_PLUGIN_MODULE_NAME="${target}"
        AXLE_PLUGIN_BUILD_CONFIGURATION="$<CONFIG>"
        AXLE_PLUGIN_SDK_FINGERPRINT="${AXLE_PLUGIN_SDK_HASH}-$<CONFIG>"
        AXLE_PLUGIN_TOOLCHAIN_FINGERPRINT="${AXLE_PLUGIN_TOOLCHAIN_ID}-$<CONFIG>"
        ax_plugin_get_descriptor=axle_static_${entryIdentity}_get_descriptor
        ax_plugin_start=axle_static_${entryIdentity}_start
        ax_plugin_stop=axle_static_${entryIdentity}_stop)
    target_link_libraries(${target} PRIVATE Axle::PluginSDK Axle::RuntimeHost)
    if(MSVC)
        target_compile_options(${target} PRIVATE /EHsc /GR /utf-8)
    endif()
endfunction()
function(axle_link_selected_runtime product)
    target_link_libraries(${product} PRIVATE ${AXLE_SELECTED_PLUGIN_MODULES})
endfunction()
function(axle_validate_plugin_module target)
    get_target_property(managed ${target} AXLE_SDK_MODULE)
    if(NOT managed)
        message(FATAL_ERROR "Selected module must use axle_add_plugin_module: ${target}")
    endif()
    get_target_property(base ${target} SOURCE_DIR)
    set(allowedRoots ${AXLE_FROZEN_PLUGIN_ROOTS} "${CMAKE_BINARY_DIR}" "${CMAKE_SOURCE_DIR}/Engine/PluginSDK/include")
    foreach(property SOURCES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
        get_target_property(inputs ${target} ${property})
        if(NOT inputs)
            continue()
        endif()
        foreach(input IN LISTS inputs)
            if(input MATCHES "\\$<")
                message(FATAL_ERROR "Frozen module compiler inputs must be literal: ${target} ${input}")
            endif()
            get_filename_component(absolute "${input}" ABSOLUTE BASE_DIR "${base}")
            file(REAL_PATH "${absolute}" absolute)
            set(allowed FALSE)
            foreach(root IN LISTS allowedRoots)
                file(REAL_PATH "${root}" normalizedRoot)
                cmake_path(IS_PREFIX normalizedRoot "${absolute}" NORMALIZE within)
                if(within)
                    set(allowed TRUE)
                endif()
            endforeach()
            if(NOT allowed)
                message(FATAL_ERROR "Module compiler input escapes frozen sources: ${target} ${input}")
            endif()
        endforeach()
    endforeach()
    set(allowedLinks ${AXLE_SELECTED_PLUGIN_MODULES} Axle::PluginSDK Axle::RuntimeHost)
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(links ${target} ${property})
        if(NOT links)
            continue()
        endif()
        foreach(link IN LISTS links)
            string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" link "${link}")
            if(NOT link IN_LIST allowedLinks)
                message(FATAL_ERROR "Static module dependency escapes the selected SDK graph: ${target} ${link}")
            endif()
            get_target_property(imported ${link} IMPORTED)
            get_target_property(type ${link} TYPE)
            if(imported OR NOT type MATCHES "^(STATIC_LIBRARY|INTERFACE_LIBRARY)$")
                message(FATAL_ERROR "Shipping module imports a nonstatic dependency: ${target} ${link}")
            endif()
        endforeach()
    endforeach()
endfunction()
