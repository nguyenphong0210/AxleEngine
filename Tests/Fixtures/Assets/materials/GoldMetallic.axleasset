Material {
    name: "GoldMetallic"
    shader: "ForwardPBR"
    useCustomShader: false

    // Texture Packing Mode
    textureMode: "SeparateMaps"
    // Surface Options
    surfaceType: "Opaque"
    cullMode: "Back"
    alphaCutoff: 0.5
    depthWrite: true
    specularHighlights: true
    environmentReflections: true
    renderQueue: 2000

    // Base Color & Texture (Clean Neutral White)
    albedoColor: "#FFFFFF"
    albedoMap: ""

    // Surface Microfacet
    metallic: 0
    roughness: 0.5
    normalMap: ""
    normalStrength: 1
    clearcoatStrength: 0
    clearcoatRoughness: 0.04
    anisotropyStrength: 0
    anisotropyRotation: 0
    occlusionMap: ""
    occlusionStrength: 1

    // Emission & UV Scaling
    emissionColor: "#000000"
    emissionIntensity: 0
    uvTiling: [ 1 , 1 ]
    uvOffset: [ 0 , 0 ]
}
