Canvas {
    id: "racing_hud_root"
    referenceResolution: [1920, 1080]

    // Top-Left Floating Minimalist Glass Telemetry Pill
    Rectangle {
        id: "telemetry_panel"
        anchor: "TopLeft"
        margin: [28, 28, 0, 0]
        size: [270, 40]
        color: "#080C1699"
        cornerRadius: 20
        borderWidth: 1.0
        borderColor: "#33415555"

        Row {
            anchor: "Center"
            spacing: 8

            Text {
                id: "fps_counter"
                text: "FPS: {Engine.FPS}"
                fontSize: 12
                color: "#38BDF8"
            }
            Text {
                text: "•"
                fontSize: 11
                color: "#64748B"
            }
            Text {
                id: "camera_mode_text"
                text: "CAM: {CameraMode}"
                fontSize: 12
                color: "#94A3B8"
            }
            Text {
                text: "•"
                fontSize: 11
                color: "#64748B"
            }
            Text {
                id: "lat_g_text"
                text: "LAT: {LateralG}"
                fontSize: 12
                color: "#CBD5E1"
            }
            Text {
                id: "long_g_text"
                text: "{LongitudinalG}"
                fontSize: 0
                color: "#00000000"
            }
        }
    }

    // Bottom-Right Modern Supercar Cockpit Dashboard (GT7 / Forza style)
    Rectangle {
        id: "tachometer_cluster"
        anchor: "BottomRight"
        margin: [0, 0, 32, 32]
        size: [390, 160]
        color: "#080C16B3"
        cornerRadius: 18
        borderWidth: 1.2
        borderColor: "{IsRedline ? #FF1E42CC : #33415555}"

        // Left Module: F1-Style Precision Pedal Telemetry & Drive Mode
        Rectangle {
            anchor: "CenterLeft"
            margin: [22, 0, 0, 0]
            size: [170, 120]
            color: "#00000000"

            Column {
                anchor: "Center"
                size: [170, 116]
                spacing: 7

                Text {
                    text: "{Horsepower} HP • AXLE"
                    fontSize: 10
                    color: "#64748B"
                }

                Row {
                    spacing: 8

                    Text {
                        text: "THR"
                        fontSize: 10
                        color: "#34D399"
                    }
                    ProgressBar {
                        id: "throttle_bar"
                        size: [136, 7]
                        value: "{Throttle}"
                        fillColor: "#10B981"
                        backgroundColor: "#1E293B88"
                        cornerRadius: 3.5
                    }
                }

                Row {
                    spacing: 8

                    Text {
                        text: "BRK"
                        fontSize: 10
                        color: "#F87171"
                    }
                    ProgressBar {
                        id: "brake_bar"
                        size: [136, 7]
                        value: "{Brake}"
                        fillColor: "#EF4444"
                        backgroundColor: "#1E293B88"
                        cornerRadius: 3.5
                    }
                }

                Row {
                    spacing: 8

                    Rectangle {
                        size: [64, 20]
                        cornerRadius: 4
                        color: "#0284C722"
                        borderWidth: 1.0
                        borderColor: "#0284C744"

                        Text {
                            anchor: "Center"
                            text: "SPORT"
                            fontSize: 10
                            color: "#38BDF8"
                        }
                    }

                    Rectangle {
                        size: [58, 20]
                        cornerRadius: 4
                        color: "#10B98122"
                        borderWidth: 1.0
                        borderColor: "#10B98144"

                        Text {
                            anchor: "Center"
                            text: "TCS ON"
                            fontSize: 10
                            color: "#34D399"
                        }
                    }
                }
            }
        }

        // Right Module: Precision Arc Tachometer, Centered Gear Badge & Speedometer
        Rectangle {
            anchor: "CenterRight"
            margin: [0, 0, 18, 0]
            size: [146, 146]
            color: "#00000000"

            RadialGauge {
                id: "rpm_radial_gauge"
                anchor: "Center"
                size: [136, 136]
                startAngle: -220.0
                endAngle: 40.0
                thickness: 6.5
                value: "{RPMNormalized}"
                color: "{IsRedline ? #FF1E42FF : #00F5D4FF}"
                trackColor: "#1E293B66"
            }

            Rectangle {
                anchor: "Center"
                pos: [0, -12]
                size: [44, 44]
                cornerRadius: 22
                color: "#0F172A88"
                borderWidth: 1.0
                borderColor: "{IsRedline ? #FF1E4288 : #33415566}"

                Text {
                    id: "gear_indicator"
                    anchor: "Center"
                    pos: [0, -1]
                    text: "{GearString}"
                    fontSize: 28
                    color: "{IsRedline ? #FF1E42FF : #FFFFFFFF}"
                }
            }

            Text {
                id: "speed_value"
                anchor: "Center"
                pos: [0, 22]
                text: "{SpeedKmh}"
                fontSize: 24
                color: "#F8FAFC"
            }

            Text {
                id: "speed_unit"
                anchor: "Center"
                pos: [0, 39]
                text: "{SpeedUnit}"
                fontSize: 10
                color: "#64748B"
            }
        }
    }
}
