{
  "schema": "axle.m14.p0.reference-fixtures",
  "version": 1,
  "description": "Deterministic reference cases for Milestone 14 baseline normalization. These cases define evidence and do not claim that the current renderer passes them.",
  "capture": {
    "color_space": "linear_hdr_before_tonemap_and_srgb_display_after_tonemap",
    "default_resolution": [128, 128],
    "comparison_backend_matrix": ["dx12", "vulkan", "gl"],
    "warmup_frames": 8,
    "sample_frames": 16,
    "diagnostics": [
      "scene_color",
      "scene_depth",
      "scene_normal",
      "material_roughness_f0",
      "hiz_level_0",
      "hiz_level_1",
      "hiz_level_2",
      "hiz_level_3",
      "hiz_level_4",
      "hiz_level_5",
      "hiz_level_6",
      "hiz_level_7",
      "gtao_contact",
      "ssr_color_confidence",
      "reflection_probe_selection",
      "motion_vectors",
      "exposure_histogram",
      "exposure_value",
      "taa_history"
    ]
  },
  "fixtures": [
    {
      "id": "smooth_sphere_surface",
      "purpose": "Separate mesh interpolation and surface-normal correctness from post-processing.",
      "resolution": [128, 128],
      "camera": {"position": [0.0, 0.0, 5.0], "look_at": [0.0, 0.0, 0.0], "fov_degrees": 55.0},
      "objects": [
        {"name": "sphere", "primitive": "sphere", "radius": 1.0, "stacks": 64, "sectors": 128, "transform": [0.0, 0.0, 0.0]},
        {"name": "ground", "primitive": "plane", "size": [12.0, 12.0], "transform": [0.0, -1.0, 0.0]}
      ],
      "material": {"base_color": [0.78, 0.80, 0.84, 1.0], "metallic": 0.0, "roughness": 0.22, "normal_map": null},
      "settings": {"gtao": false, "contact_shadows": false, "ssr": false, "bloom": false, "auto_exposure": false, "taa": false},
      "checks": ["defined_surface_normal", "no_triangle_banding", "finite_radiance"]
    },
    {
      "id": "metal_sphere_reflection_hit",
      "purpose": "Prove that a nearby object is present in a reflective sphere and that reflection is not only a sky highlight.",
      "resolution": [128, 128],
      "camera": {"position": [0.0, 0.8, 5.0], "look_at": [0.0, 0.4, 0.0], "fov_degrees": 55.0},
      "objects": [
        {"name": "sphere", "primitive": "sphere", "radius": 1.0, "stacks": 64, "sectors": 128, "transform": [0.0, 1.0, 0.0]},
        {"name": "red_box", "primitive": "cube", "size": [1.0, 1.0, 1.0], "transform": [-1.6, 0.5, 0.0], "color": [0.85, 0.04, 0.02, 1.0]},
        {"name": "ground", "primitive": "plane", "size": [12.0, 12.0], "transform": [0.0, 0.0, 0.0]}
      ],
      "material": {"base_color": [0.83, 0.57, 0.16, 1.0], "metallic": 1.0, "roughness": 0.04, "normal_map": null},
      "settings": {"gtao": false, "contact_shadows": false, "ssr": true, "bloom": false, "auto_exposure": false, "taa": false},
      "checks": ["red_box_reflection_hit", "roughness_uses_material_f0", "miss_fallback_is_not_constant_gray"]
    },
    {
      "id": "roughness_metallic_sweep",
      "purpose": "Check that roughness controls reflection width and metallic controls diffuse/specular energy consistently.",
      "resolution": [320, 96],
      "camera": {"position": [0.0, 0.0, 6.0], "look_at": [0.0, 0.0, 0.0], "fov_degrees": 40.0},
      "objects": [
        {"name": "roughness_004", "primitive": "sphere", "transform": [-2.0, 0.0, 0.0], "roughness": 0.04},
        {"name": "roughness_012", "primitive": "sphere", "transform": [-1.0, 0.0, 0.0], "roughness": 0.12},
        {"name": "roughness_025", "primitive": "sphere", "transform": [0.0, 0.0, 0.0], "roughness": 0.25},
        {"name": "roughness_050", "primitive": "sphere", "transform": [1.0, 0.0, 0.0], "roughness": 0.50},
        {"name": "roughness_080", "primitive": "sphere", "transform": [2.0, 0.0, 0.0], "roughness": 0.80}
      ],
      "material": {"base_color": [0.80, 0.52, 0.12, 1.0], "metallic": 1.0},
      "settings": {"gtao": false, "contact_shadows": false, "ssr": true, "bloom": false, "auto_exposure": false, "taa": false},
      "checks": ["monotonic_reflection_blur", "finite_energy", "no_intensity_jump"]
    },
    {
      "id": "exposure_bloom_impulse",
      "purpose": "Check global exposure adaptation and one-time, multiscale bloom gain.",
      "resolution": [128, 128],
      "objects": [{"name": "bright_panel", "primitive": "emissive_plane", "transform": [0.0, 0.0, 0.0], "emission": [20.0, 20.0, 20.0]}],
      "material": {"base_color": [1.0, 1.0, 1.0, 1.0], "metallic": 0.0, "roughness": 0.5},
      "settings": {"bloom": true, "bloom_threshold": 1.0, "bloom_intensity": 0.8, "auto_exposure": true, "auto_exposure_speed": 3.0},
      "checks": ["global_histogram", "adapted_exposure_changes", "halo_gain_is_controlled"]
    },
    {
      "id": "temporal_motion_and_reset",
      "purpose": "Check reprojection, disocclusion rejection and history ownership across motion, resize and view changes.",
      "resolution": [128, 128],
      "objects": [{"name": "moving_box", "primitive": "cube", "transform": [0.0, 0.0, 0.0], "velocity": [0.75, 0.0, 0.0]}],
      "settings": {"taa": true, "taa_feedback_min": 0.88, "taa_feedback_max": 0.96},
      "events": ["camera_jitter", "object_motion", "camera_cut", "resize", "view_switch"],
      "checks": ["motion_vectors_present", "no_history_ghost", "history_invalidates_on_event"]
    },
    {
      "id": "screen_space_resource_edges",
      "purpose": "Check depth/normal/Hi-Z resource contracts on odd dimensions and feature toggles.",
      "resolutions": [[1, 1], [3, 5], [1919, 1079], [1920, 1080], [2560, 1440]],
      "settings_matrix": [
        {"gtao": true, "contact_shadows": false, "ssr": false, "bloom": false, "auto_exposure": false, "taa": false},
        {"gtao": false, "contact_shadows": false, "ssr": true, "bloom": false, "auto_exposure": false, "taa": false},
        {"gtao": true, "contact_shadows": true, "ssr": true, "bloom": true, "auto_exposure": true, "taa": true}
      ],
      "checks": ["all_required_targets_allocated", "all_graph_reads_declared", "no_descriptor_update_after_bind", "no_failed_view_submission"]
    }
  ]
}
