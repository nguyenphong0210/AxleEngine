      "description": "Physics subsystem must not depend directly on rendering, GPU resources, asset DSL, scene, or UI."
    },
    {
      "from": "Scene",
      "forbidden_to": ["UI", "Editor", "Runtime"],
      "description": "Scene data and simulation must not depend on Editor tooling UI or application hosts."
    },
    {
      "from": "Spline",
