  "forbidden_include_rules": [
    {
      "from": "Core",
      "forbidden_to": ["Platform", "RHI", "Renderer", "Audio", "Asset", "Physics", "Animation", "VFX", "Project", "UI2D", "Scene", "UI", "Spline", "Terrain", "Editor", "Runtime"],
