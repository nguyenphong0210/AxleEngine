      "description": "Spline plugin must not depend on Editor UI or host applications."
    },
    {
      "from": "Terrain",
      "forbidden_to": ["UI", "Editor", "Runtime"],
      "description": "Terrain plugin must not depend on Editor UI or host applications."
    },
    {
      "from": "Runtime",
      "forbidden_to": ["UI", "Editor"],
      "description": "Standalone player Runtime must never depend on Dear ImGui Editor tooling UI or Editor composition."
    }
