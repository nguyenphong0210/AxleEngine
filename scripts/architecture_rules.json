    },
    {
      "from": "Asset",
      "forbidden_to": ["Renderer", "RHI", "Scene", "UI", "Editor", "Runtime"],
      "description": "Asset subsystem must not depend on GPU rendering, scene, or UI."
    },
    {
      "from": "Physics",
